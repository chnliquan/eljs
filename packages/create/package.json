{
  "name": "@eljs/create",
  "version": "1.3.2-alpha.0",
  "description": "Powerful and flexible project creation tool from templates with comprehensive automation support.",
  "keywords": [
    "eljs",
    "create",
    "template"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/create#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/create"
  },
  "license": "MIT",
  "author": "chnliquan",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create": "./bin/create.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@eljs/plugin-host": "workspace:*",
    "@eljs/utils": "workspace:*",
    "commander": "^14.0.3",
    "dayjs": "^1.11.13",
    "ora": "^5.4.1",
    "sort-package-json": "^4.0.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/update-notifier": "^6.0.8"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
