{
  "name": "@eljs/pluggable",
  "version": "1.3.1",
  "description": "A powerful, type-safe plugin system with zero-configuration setup and flexible extensibility.",
  "keywords": [
    "eljs",
    "pluggable"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/pluggable#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/pluggable"
  },
  "license": "MIT",
  "author": "chnliquan",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@eljs/config": "workspace:*",
    "@eljs/utils": "workspace:*",
    "hash-sum": "^2.0.0",
    "pkg-up": "^3.1.0",
    "tapable": "^2.2.1"
  },
  "devDependencies": {
    "@types/hash-sum": "^1.0.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
