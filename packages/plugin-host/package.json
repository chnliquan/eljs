{
  "name": "@eljs/plugin-host",
  "version": "1.3.2-alpha.0",
  "description": "A type-safe plugin host for Node.js tools with presets, ordered hooks, and extensible APIs.",
  "keywords": [
    "eljs",
    "plugin",
    "plugin-host",
    "plugin-system",
    "hooks"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/plugin-host#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/plugin-host"
  },
  "license": "MIT",
  "author": "chnliquan",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@eljs/config": "workspace:*",
    "@eljs/utils": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "tapable": "^2.2.1"
  },
  "devDependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
