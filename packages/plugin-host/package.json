{
  "name": "@eljs/plugin-host",
  "version": "2.0.0-beta.6",
  "description": "A type-safe plugin host for Node.js tools with presets, ordered hooks, and extensible plugin contexts.",
  "keywords": [
    "eljs",
    "plugin",
    "plugin-host",
    "plugin-system",
    "hooks"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/plugin-host#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/plugin-host"
  },
  "license": "MIT",
  "author": "chnliquan",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.zh-CN.md",
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@eljs/config-loader": "workspace:*",
    "@eljs/utils": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "tapable": "^2.2.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
