{
  "name": "@eljs/conventional-changelog-preset",
  "version": "2.0.0-beta.0",
  "description": "Conventional changelog preset for @eljs/release.",
  "keywords": [
    "eljs",
    "conventional-changelog",
    "preset"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/conventional-changelog-preset#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/conventional-changelog-preset"
  },
  "license": "MIT",
  "author": "chnliquan",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@conventional-changelog/template": "^1.4.0",
    "conventional-changelog-writer": "^9.2.1",
    "conventional-commits-parser": "^7.1.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
