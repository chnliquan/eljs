{
  "name": "@eljs/conventional-changelog-preset",
  "version": "2.0.0-beta.5",
  "description": "Conventional changelog preset for @eljs/release.",
  "keywords": [
    "eljs",
    "conventional-changelog",
    "preset"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/conventional-changelog-preset#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/conventional-changelog-preset"
  },
  "license": "MIT",
  "author": "chnliquan",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "lint": "eslint src __tests__ --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts packages/conventional-changelog-preset/__tests__",
    "test:coverage": "vitest run --config ../../vitest.config.ts packages/conventional-changelog-preset/__tests__ --coverage --coverage.include='packages/conventional-changelog-preset/src/**/*.ts'",
    "test:watch": "vitest --config ../../vitest.config.ts packages/conventional-changelog-preset/__tests__",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@conventional-changelog/template": "^1.4.0",
    "conventional-changelog-writer": "^9.3.0",
    "conventional-commits-parser": "^7.1.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
