{
  "name": "@eljs/release",
  "version": "1.3.2-alpha.0",
  "description": "Powerful and flexible npm package release tool with comprehensive automation support.",
  "keywords": [
    "eljs",
    "npm",
    "release"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/release#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs",
    "directory": "packages/release"
  },
  "license": "MIT",
  "author": "chnliquan",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "release": "./bin/release.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "lint": "eslint src __tests__ --max-warnings=0",
    "test": "vitest run packages/release/__tests__",
    "test:watch": "vitest packages/release/__tests__",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@eljs/conventional-changelog-preset": "workspace:*",
    "@eljs/plugin-host": "workspace:*",
    "@eljs/utils": "workspace:*",
    "@types/resolve-bin": "^0.4.3",
    "@types/semver": "^7.5.8",
    "commander": "^14.0.3",
    "concat-stream": "^2.0.0",
    "conventional-changelog": "^8.1.0",
    "new-github-release-url": "^1.0.0",
    "open": "^8.4.2",
    "resolve-bin": "^1.0.1",
    "semver": "^7.7.1",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/concat-stream": "^2.0.3",
    "@types/update-notifier": "^6.0.8"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
