{
  "name": "@eljs/create-template",
  "version": "1.3.2-alpha.0",
  "description": "Create a new project with predefined templates powered by @eljs/create.",
  "keywords": [
    "eljs",
    "create-template",
    "web template",
    "node template"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/create-template#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs",
    "directory": "packages/create-template"
  },
  "license": "MIT",
  "author": "chnliquan",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-template": "./bin/create-template.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@eljs/create": "workspace:*",
    "@eljs/utils": "workspace:*",
    "commander": "^14.0.3",
    "update-notifier": "^5.1.0"
  },
  "devDependencies": {
    "@types/update-notifier": "^6.0.8"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
