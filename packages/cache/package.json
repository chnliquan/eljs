{
  "name": "@eljs/cache",
  "version": "2.0.0-alpha.0",
  "description": "Persistent memory-and-disk cache for Node.js tools with TTL validation and bounded cleanup.",
  "keywords": [
    "eljs",
    "cache",
    "persistent-cache",
    "ttl",
    "lru"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/cache#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/cache"
  },
  "license": "MIT",
  "author": "chnliquan",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "lint": "eslint src __tests__ --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.mts packages/cache/__tests__",
    "test:coverage": "vitest run --config ../../vitest.config.mts packages/cache/__tests__ --coverage --coverage.include='packages/cache/src/**/*.ts'",
    "test:watch": "vitest --config ../../vitest.config.mts packages/cache/__tests__",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
