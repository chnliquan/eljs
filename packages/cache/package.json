{
  "name": "@eljs/cache",
  "version": "1.3.1",
  "description": "An intelligent caching system with zero-configuration setup and smart cleanup capabilities.",
  "keywords": [
    "eljs",
    "cache",
    "performance",
    "smart-cache"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/cache#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/cache"
  },
  "license": "MIT",
  "author": "chnliquan",
  "main": "lib/index.js",
  "types": "esm/index.d.ts",
  "files": [
    "esm/*",
    "lib/*"
  ],
  "scripts": {
    "build": "father build",
    "clean": "rimraf lib && rimraf esm && rimraf node_modules/.cache/father",
    "dev": "father dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@eljs/utils": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
