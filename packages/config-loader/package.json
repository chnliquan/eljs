{
  "name": "@eljs/config-loader",
  "version": "2.0.0-beta.5",
  "description": "Configuration discovery, loading, merging, and validation for Node.js tools.",
  "keywords": [
    "eljs",
    "config",
    "loader"
  ],
  "homepage": "https://github.com/chnliquan/eljs/tree/master/packages/config-loader#readme",
  "bugs": {
    "url": "https://github.com/chnliquan/eljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs.git",
    "directory": "packages/config-loader"
  },
  "license": "MIT",
  "author": "chnliquan",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.zh-CN.md",
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "clean": "rimraf dist",
    "dev": "rslib build --watch",
    "test": "vitest run --config ../../vitest.config.ts packages/config-loader/__tests__",
    "test:watch": "vitest --config ../../vitest.config.ts packages/config-loader/__tests__",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@eljs/utils": "workspace:*"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
