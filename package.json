{
  "name": "eljs",
  "version": "1.3.1",
  "private": true,
  "description": "A comprehensive collection of modern Node.js development tools for building robust applications and automation workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs"
  },
  "license": "MIT",
  "author": "chnliquan",
  "scripts": {
    "add-owner": "tsx scripts/add-owner",
    "boot": "tsx scripts/bootstrap",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "coverage": "vitest run --coverage",
    "dev": "turbo run dev",
    "format": "prettier --write 'packages/**/*.{ts,tsx}'",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint 'packages/**/*.{ts,tsx}'",
    "pack:check": "tsx scripts/check-packages.ts",
    "prepare": "husky",
    "prerelease:alpha": "tsx scripts/release --npm.prereleaseId=alpha",
    "prerelease:beta": "tsx scripts/release --npm.prereleaseId=beta",
    "prerelease:next": "tsx scripts/release --npm.prereleaseId=next",
    "release": "tsx scripts/release",
    "release:major": "tsx scripts/release major",
    "release:minor": "tsx scripts/release minor",
    "release:patch": "tsx scripts/release patch",
    "test": "vitest run",
    "test:w": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "resolutions": {
    "esbuild": "0.25.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eljs/create": "workspace:*",
    "@eljs/release": "workspace:*",
    "@eljs/utils": "workspace:*",
    "@types/inquirer": "^9.0.7",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-dirs": "^0.0.4",
    "eslint-plugin-prettier": "^5.2.3",
    "father": "^4.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "only-allow": "^1.2.1",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "zx": "^8.4.1"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.17.0"
  },
  "overwrites": {
    "esbuild": "0.25.0"
  }
}
