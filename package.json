{
  "name": "eljs",
  "version": "1.3.2-alpha.0",
  "private": true,
  "description": "A comprehensive collection of modern Node.js development tools for building robust applications and automation workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chnliquan/eljs"
  },
  "license": "MIT",
  "author": "chnliquan",
  "scripts": {
    "add-owner": "tsx scripts/add-owner.ts",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "coverage": "vitest run --coverage",
    "dev": "turbo run dev",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint . --max-warnings=0",
    "pack:check": "node --import tsx scripts/check-packages.ts",
    "package:create": "tsx scripts/create-package.ts",
    "prepare": "husky",
    "release": "tsx scripts/release.ts",
    "release:alpha": "tsx scripts/release.ts --npm.prereleaseId=alpha",
    "release:beta": "tsx scripts/release.ts --npm.prereleaseId=beta",
    "release:major": "tsx scripts/release.ts major",
    "release:minor": "tsx scripts/release.ts minor",
    "release:next": "tsx scripts/release.ts --npm.prereleaseId=next",
    "release:patch": "tsx scripts/release.ts patch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm verify:static && pnpm verify:test && pnpm verify:package",
    "verify:package": "pnpm build && pnpm pack:check",
    "verify:static": "pnpm format:check && pnpm lint && pnpm typecheck",
    "verify:test": "pnpm coverage"
  },
  "lint-staged": {
    "*": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eljs/release": "workspace:*",
    "@eljs/utils": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@rslib/core": "0.23.2",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "only-allow": "^1.2.1",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "zx": "^8.4.1"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.17.0"
  }
}
